{% extends 'base.html.jinja' %}

{% block title %}Słowniki{% endblock %}

{% block content %}
<div class="mb-8 rounded-[2rem] bg-emerald-50 p-8 shadow-md ring-1 ring-emerald-200">
    <h2 class="text-3xl font-semibold text-emerald-900">Zarządzanie słownikami</h2>
    <p class="mt-3 text-emerald-700">Dodawaj, edytuj i usuwaj autorów, wydawców, serie, gatunki, tematy i działy.</p>
</div>

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {% for dict_type, label in dictionaries %}
    <a href="{% url 'dictionary_list' dict_type %}" class="rounded-2xl border border-emerald-100 bg-white p-6 shadow-sm transition hover:shadow-md hover:ring-1 hover:ring-emerald-200">
        <h3 class="text-lg font-semibold text-emerald-900">{{ label }}</h3>
        <p class="mt-2 text-sm text-emerald-600">Zarządzaj →</p>
    </a>
    {% endfor %}
</div>
{% endblock %}
