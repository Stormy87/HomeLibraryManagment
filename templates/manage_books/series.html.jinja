{% extends 'base.html.jinja' %}

{% block title %}Seria{% endblock %}

{% block header %}Szczegóły serii{% endblock %}

{% block content %}
<div class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm">
    <h2 class="text-2xl font-semibold text-slate-900">Seria</h2>
    <p class="mt-4 text-slate-700">Wybrana seria: <strong>{{ series_id }}</strong></p>
    <p class="mt-2 text-slate-600">Tutaj pojawią się informacje o serii oraz książkach należących do niej.</p>
</div>
{% endblock %}
