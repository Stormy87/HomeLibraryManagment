{% extends 'base.html.jinja' %}

{% block title %}{{ author.first_name }} {{ author.last_name }}{% endblock %}

{% block content %}
<div class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <h2 class="text-2xl font-semibold text-slate-900">
            {% if author.title %}{{ author.get_title_display }} {% endif %}{{ author.first_name }} {{ author.last_name }}
            {% if author.alias %}<span class="text-lg text-slate-600">({{ author.alias }})</span>{% endif %}
        </h2>
        {% if user.is_authenticated %}
        <a href="{% url 'author_edit' author.id %}" class="rounded-lg border border-emerald-600 px-4 py-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-50">Edytuj dane autora</a>
        {% endif %}
    </div>

    <div class="mt-6 grid grid-cols-2 gap-6">
        <div>
            <p class="text-sm text-slate-600">Narodowość</p>
            <p class="text-lg font-semibold text-slate-900">{{ author.nationality }}</p>
        </div>
        {% if author.title %}
        <div>
            <p class="text-sm text-slate-600">Tytuł naukowy</p>
            <p class="text-lg font-semibold text-slate-900">{{ author.get_title_display }}</p>
        </div>
        {% endif %}
    </div>
</div>

<div class="mt-8 rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm">
    <h3 class="text-xl font-semibold text-slate-900">Książki autora w mojej bibliotece</h3>
    {% if books %}
    <ul class="mt-6 space-y-3">
        {% for book in books %}
        <li><a href="{% url 'book' book.id %}" class="text-emerald-600 hover:text-emerald-800 font-medium">{{ book.title }}</a></li>
        {% endfor %}
    </ul>
    {% else %}
    <p class="mt-6 text-slate-600">Ten autor nie ma książek w bibliotece.</p>
    {% endif %}
</div>
{% endblock %}
