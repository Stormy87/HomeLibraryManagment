{% extends 'base.html.jinja' %}

{% block title %}Moja biblioteka książek{% endblock %}

{% block content %}
<div class="mb-8 rounded-[2rem] bg-emerald-50 p-8 shadow-md ring-1 ring-emerald-200">
    <h2 class="text-3xl font-semibold text-emerald-900">Moja biblioteka książek</h2>
    <p class="mt-3 max-w-3xl text-emerald-700">Przeglądaj wszystkie książki, ulubione pozycje, przeczytane tytuły oraz wybieraj filtrowanie według gatunku i tematu.</p>
</div>

<div class="grid gap-7 lg:grid-cols-[320px_1fr]">
    <div class="space-y-6">
        <div class="rounded-[1.75rem] bg-white p-6 shadow-sm ring-1 ring-emerald-100">
            <h3 class="text-lg font-semibold text-emerald-900">Filtruj książki</h3>
            <div class="mt-5 space-y-4 text-emerald-700">
                <div>
                    <p class="text-sm font-semibold text-emerald-900">Gatunki</p>
                    {% if genres %}
                    <ul class="mt-2 space-y-2">
                        {% for genre in genres %}
                        <li><a href="#" class="text-sm text-emerald-600 hover:text-emerald-800">{{ genre.name }}</a></li>
                        {% endfor %}
                    </ul>
                    {% else %}
                    <p class="mt-2 text-sm text-emerald-500">Brak gatunków do filtrowania.</p>
                    {% endif %}
                </div>
                <div>
                    <p class="text-sm font-semibold text-emerald-900">Tematy</p>
                    {% if topics %}
                    <ul class="mt-2 space-y-2">
                        {% for topic in topics %}
                        <li><a href="#" class="text-sm text-emerald-600 hover:text-emerald-800">{{ topic.name }}</a></li>
                        {% endfor %}
                    </ul>
                    {% else %}
                    <p class="mt-2 text-sm text-emerald-500">Brak tematów do filtrowania.</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="rounded-[1.75rem] bg-white p-6 shadow-sm ring-1 ring-emerald-100">
            <h3 class="text-lg font-semibold text-emerald-900">Ulubione książki</h3>
            {% if favorite_books %}
            <ul class="mt-3 space-y-2">
                {% for book in favorite_books %}
                <li><a href="{% url 'book' book.id %}" class="text-sm text-emerald-600 hover:text-emerald-800">{{ book.title }}</a></li>
                {% endfor %}
            </ul>
            {% else %}
            <p class="mt-3 text-sm text-emerald-500">Nie dodałeś jeszcze ulubionych książek.</p>
            {% endif %}
        </div>

        <div class="rounded-[1.75rem] bg-white p-6 shadow-sm ring-1 ring-emerald-100">
            <h3 class="text-lg font-semibold text-emerald-900">Przeczytane książki</h3>
            {% if read_books %}
            <p class="mt-3 text-sm text-emerald-600">Przeczytano: {{ read_books|length }} książek</p>
            {% else %}
            <p class="mt-3 text-sm text-emerald-500">Jeszcze nie oznaczyłeś żadnej książki jako przeczytanej.</p>
            {% endif %}
        </div>
    </div>

    <div class="rounded-[1.75rem] bg-white p-6 shadow-sm ring-1 ring-slate-200">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h3 class="text-lg font-semibold text-slate-900">Wszystkie książki</h3>
                <p class="text-sm text-slate-500">Kliknij tytuł, aby przejść do szczegółów książki.</p>
            </div>
            <button class="rounded-2xl bg-amber-500 px-5 py-2 text-sm font-semibold text-slate-900 shadow-sm transition hover:bg-amber-400">Dodaj książkę</button>
        </div>

        <div class="mt-6 overflow-hidden rounded-3xl border border-emerald-100 bg-emerald-50">
            <table class="min-w-full divide-y divide-emerald-100 text-left text-sm">
                <thead class="bg-emerald-100 text-emerald-900">
                    <tr>
                        <th class="px-6 py-4 font-medium">Tytuł</th>
                        <th class="px-6 py-4 font-medium">Autor</th>
                        <th class="px-6 py-4 font-medium">Wydawca</th>
                        <th class="px-6 py-4 font-medium">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 bg-white text-slate-600">
                    {% if books %}
                        {% for book in books %}
                        <tr class="hover:bg-slate-50">
                            <td class="px-6 py-5"><a href="{% url 'book' book.id %}" class="text-emerald-600 hover:text-emerald-800 font-medium">{{ book.title }}</a></td>
                            <td class="px-6 py-5">
                                {% if book.authors.all %}
                                    {% for author in book.authors.all %}
                                    <a href="{% url 'author' author.id %}" class="text-emerald-600 hover:text-emerald-800">{{ author.name }} {{ author.last_name }}</a>{% if not forloop.last %}, {% endif %}
                                    {% endfor %}
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                            <td class="px-6 py-5">
                                {% if book.publisher %}
                                <a href="{% url 'publisher' book.publisher.id %}" class="text-emerald-600 hover:text-emerald-800">{{ book.publisher.name }}</a>
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                            <td class="px-6 py-5">
                                {% if book.is_favorite and book.is_read %}
                                    <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">⭐ Przeczytana</span>
                                {% elif book.is_favorite %}
                                    <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">⭐ Ulubiona</span>
                                {% elif book.is_read %}
                                    <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-800">✓ Przeczytana</span>
                                {% else %}
                                    <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">— Nie przeczytana</span>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    {% else %}
                    <tr>
                        <td class="px-6 py-5" colspan="4">Brak książek w bibliotece.</td>
                    </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Get favorite and read book counts for side panels
    const books = document.querySelectorAll('tbody tr');
    let favoriteCount = 0;
    let readCount = 0;
    
    books.forEach(row => {
        const statusCell = row.querySelector('td:last-child');
        if (statusCell) {
            const status = statusCell.textContent;
            if (status.includes('Ulubiona') || status.includes('Przeczytana')) {
                if (status.includes('⭐')) favoriteCount++;
                if (status.includes('✓') || status.includes('⭐ Przeczytana')) readCount++;
            }
        }
    });
});
</script>
{% endblock %}
