{% extends 'base.html.jinja' %}

{% block title %}{{ series.name }}{% endblock %}

{% block content %}
<div class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm">
    <h2 class="text-2xl font-semibold text-slate-900">{{ series.name }}</h2>

    {% if series.description %}
    <div class="mt-6">
        <p class="text-sm text-slate-600">Opis</p>
        <p class="mt-2 text-slate-700">{{ series.description }}</p>
    </div>
    {% endif %}

    <p class="mt-6 text-lg font-semibold text-emerald-800">
        Posiadam <span class="text-2xl">{{ books_count }}</span> książek z tej serii w bibliotece.
    </p>
</div>

<div class="mt-8 rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm">
    <h3 class="text-xl font-semibold text-slate-900">Książki w serii (wg daty publikacji)</h3>
    {% if books %}
    <ul class="mt-6 space-y-3">
        {% for book in books %}
        <li>
            <a href="{% url 'book' book.id %}" class="font-medium text-emerald-600 hover:text-emerald-800">{{ book.title }}</a>
            <span class="text-sm text-slate-500">({{ book.publication_date.year }})</span>
        </li>
        {% endfor %}
    </ul>
    {% else %}
    <p class="mt-6 text-slate-600">Nie posiadasz książek z tej serii w bibliotece.</p>
    {% endif %}
</div>
{% endblock %}
