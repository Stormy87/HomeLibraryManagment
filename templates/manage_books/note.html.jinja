{% extends 'base.html.jinja' %}

{% block title %}Notatka{% endblock %}

{% block header %}Szczegóły notatki{% endblock %}

{% block content %}
<div class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm">
    <div class="mb-6 border-b border-slate-200 pb-6">
        <p class="text-sm text-slate-600">Powiązana książka</p>
        <h2 class="mt-2 text-2xl font-semibold text-slate-900">
            <a href="{% url 'book' note.book.id %}" class="text-emerald-600 hover:text-emerald-800">{{ note.book.title }}</a>
        </h2>
    </div>
    
    <div class="mb-6">
        <p class="text-sm text-slate-600">Data utworzenia</p>
        <p class="mt-2 text-slate-700">{{ note.created_at|date:"d M Y, H:i" }}</p>
    </div>
    
    <div>
        <p class="text-sm text-slate-600">Treść notatki</p>
        <div class="mt-4 rounded-lg bg-slate-50 p-4">
            <p class="whitespace-pre-wrap text-slate-700">{{ note.content }}</p>
        </div>
    </div>
</div>

<div class="mt-8">
    <a href="{% url 'book' note.book.id %}" class="inline-flex items-center gap-2 rounded-2xl bg-slate-100 px-5 py-2 text-sm font-semibold text-slate-900 shadow-sm transition hover:bg-slate-200">
        ← Powrót do książki
    </a>
</div>
{% endblock %}