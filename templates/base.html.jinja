<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Home Library Management System{% endblock %}</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="min-h-screen bg-emerald-50 text-slate-900">
    <div class="bg-gradient-to-r from-emerald-800 via-emerald-700 to-emerald-900 text-emerald-50 shadow-lg">
        <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.36em] text-emerald-200">Ewidencja biblioteczna</p>
                <h1 class="text-2xl font-semibold tracking-tight">Home Library</h1>
            </div>
            <div class="flex flex-wrap gap-2">
                <a href="{% url 'index' %}" class="rounded-lg border border-emerald-700 bg-emerald-700 px-4 py-2 text-sm font-semibold text-emerald-50 transition hover:bg-emerald-600">Strona główna</a>
                {% if user.is_authenticated %}
                    <a href="{% url 'book_add' %}" class="rounded-lg bg-amber-500 px-4 py-2 text-sm font-semibold text-slate-900 transition hover:bg-amber-400">Dodaj książkę</a>
                    <a href="{% url 'dictionaries' %}" class="rounded-lg border border-emerald-600 px-4 py-2 text-sm font-semibold text-emerald-50 transition hover:bg-emerald-700">Słowniki</a>
                    <span class="rounded-lg border border-emerald-600 px-4 py-2 text-sm text-emerald-200">{{ user.username }}</span>
                    <a href="{% url 'logout' %}" class="rounded-lg border border-emerald-700 bg-emerald-800 px-4 py-2 text-sm font-semibold text-emerald-50 transition hover:bg-emerald-700">Wyloguj</a>
                {% else %}
                    <a href="{% url 'login' %}" class="rounded-lg bg-amber-500 px-4 py-2 text-sm font-semibold text-slate-900 transition hover:bg-amber-400">Zaloguj się</a>
                    <a href="{% url 'register' %}" class="rounded-lg border border-emerald-700 bg-emerald-800 px-4 py-2 text-sm font-semibold text-emerald-50 transition hover:bg-emerald-700">Rejestracja</a>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        {% if messages %}
        <div class="mb-6 space-y-2">
            {% for message in messages %}
            <div class="rounded-xl px-4 py-3 text-sm font-medium {% if message.tags == 'error' %}bg-red-100 text-red-800{% elif message.tags == 'info' %}bg-blue-100 text-blue-800{% else %}bg-emerald-100 text-emerald-800{% endif %}">
                {{ message }}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        {% block content %}{% endblock %}
    </div>

    <footer class="border-t border-emerald-200 bg-emerald-50 py-5 text-center text-sm text-emerald-700">
        Home Library Management System — zarządzanie osobistą biblioteką książek.
    </footer>
</body>
</html>
