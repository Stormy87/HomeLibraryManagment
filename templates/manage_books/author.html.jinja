{% extends 'base.html.jinja' %}

{% block title %}Autor{% endblock %}

{% block header %}Szczegóły autora{% endblock %}

{% block content %}
<div class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm">
    <h2 class="text-2xl font-semibold text-slate-900">Autor</h2>
    <p class="mt-4 text-slate-700">Wybrany autor: <strong>{{ author_id }}</strong></p>
