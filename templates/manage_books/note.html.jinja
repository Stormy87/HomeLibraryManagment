{% extends 'base.html.jinja' %}

{% block title %}Notatka{% endblock %}

{% block header %}Szczegóły notatki{% endblock %}

{% block content %}
<div class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm">
    <h2 class="text-2xl font-semibold text-slate-900">Notatka</h2>
    <p class="mt-4 text-slate-700">Wybrana notatka: <strong>{{ note_id }}</strong></p>
