{% extends 'base.html.jinja' %}

{% block title %}Logowanie{% endblock %}

{% block content %}
<div class="mx-auto max-w-md rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm">
    <h2 class="text-2xl font-semibold text-slate-900">Zaloguj się</h2>
    <p class="mt-2 text-sm text-slate-600">Nie masz konta? <a href="{% url 'register' %}" class="text-emerald-600 hover:text-emerald-800">Zarejestruj się</a></p>

    <form method="post" class="mt-6 space-y-4">
        {% csrf_token %}
        {% for field in form %}
        <div>
            <label class="mb-1 block text-sm font-medium text-slate-700">{{ field.label }}</label>
            {{ field }}
            {% if field.errors %}<p class="mt-1 text-sm text-red-600">{{ field.errors.0 }}</p>{% endif %}
        </div>
        {% endfor %}
        <button type="submit" class="w-full rounded-lg bg-amber-500 px-4 py-2 font-semibold text-slate-900 hover:bg-amber-400">Zaloguj się</button>
    </form>
</div>
<style>
    form input { width: 100%; border-radius: 0.5rem; border: 1px solid #cbd5e1; padding: 0.5rem 0.75rem; }
</style>
{% endblock %}
