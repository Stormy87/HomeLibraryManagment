{% extends 'base.html.jinja' %}

{% block title %}Moja biblioteka książek{% endblock %}

{% block content %}
<div class="mb-8 rounded-[2rem] bg-emerald-50 p-8 shadow-md ring-1 ring-emerald-200">
    <h2 class="text-3xl font-semibold text-emerald-900">Moja biblioteka książek</h2>
    <p class="mt-3 max-w-3xl text-emerald-700">Przeglądaj wszystkie książki, ulubione pozycje, przeczytane tytuły oraz wybieraj filtrowanie według gatunku i tematu.</p>
</div>

<div class="grid gap-7 lg:grid-cols-[320px_1fr]">
    <div class="space-y-6">
        <div class="rounded-[1.75rem] bg-white p-6 shadow-sm ring-1 ring-emerald-100">
            <h3 class="text-lg font-semibold text-emerald-900">Filtruj książki</h3>
            <div class="mt-5 space-y-4 text-emerald-700">
                <div>
                    <p class="text-sm font-semibold text-emerald-900">Gatunki</p>
                    <p class="mt-2 text-sm text-emerald-500">Brak gatunków do filtrowania.</p>
                </div>
                <div>
                    <p class="text-sm font-semibold text-emerald-900">Tematy</p>
                    <p class="mt-2 text-sm text-emerald-500">Brak tematów do filtrowania.</p>
                </div>
            </div>
        </div>

        <div class="rounded-[1.75rem] bg-white p-6 shadow-sm ring-1 ring-emerald-100">
            <h3 class="text-lg font-semibold text-emerald-900">Ulubione książki</h3>
            <p class="mt-3 text-sm text-emerald-500">Nie dodałeś jeszcze ulubionych książek.</p>
        </div>

        <div class="rounded-[1.75rem] bg-white p-6 shadow-sm ring-1 ring-emerald-100">
            <h3 class="text-lg font-semibold text-emerald-900">Przeczytane książki</h3>
            <p class="mt-3 text-sm text-emerald-500">Jeszcze nie oznaczyłeś żadnej książki jako przeczytanej.</p>
        </div>
    </div>

    <div class="rounded-[1.75rem] bg-white p-6 shadow-sm ring-1 ring-slate-200">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h3 class="text-lg font-semibold text-slate-900">Wszystkie książki</h3>
                <p class="text-sm text-slate-500">Kliknij tytuł, aby przejść do szczegółów książki.</p>
            </div>
            <button class="rounded-2xl bg-amber-500 px-5 py-2 text-sm font-semibold text-slate-900 shadow-sm transition hover:bg-amber-400">Dodaj książkę</button>
        </div>

        <div class="mt-6 overflow-hidden rounded-3xl border border-emerald-100 bg-emerald-50">
            <table class="min-w-full divide-y divide-emerald-100 text-left text-sm">
                <thead class="bg-emerald-100 text-emerald-900">
                    <tr>
                        <th class="px-6 py-4 font-medium">Tytuł</th>
                        <th class="px-6 py-4 font-medium">Autor</th>
                        <th class="px-6 py-4 font-medium">Wydawca</th>
                        <th class="px-6 py-4 font-medium">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 bg-white text-slate-600">
                    <tr>
                        <td class="px-6 py-5">Brak książek w bibliotece.</td>
                        <td class="px-6 py-5"></td>
                        <td class="px-6 py-5"></td>
                        <td class="px-6 py-5"></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
